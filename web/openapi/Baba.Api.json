        "required": [
          "nameAr",
          "nameEn",
          "countryCode",
          "baseCurrencyCode",
          "fiscalYearStartMonth",
          "firstFiscalYear",
          "taxNumbers",
          "address",
          "chartTemplateKey",
          "enabledModules"
