        "type": "object",
        "properties": {
          "nameAr": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "baseCurrencyCode": {
            "type": "string"
          },
          "fiscalYearStartMonth": {
            "type": "integer",
            "format": "int32"
